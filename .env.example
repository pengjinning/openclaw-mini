# 智谱开放平台普通 API（通过 OpenAI 兼容接口接入，不是 GLM Coding Plan）
OPENCLAW_MINI_PROVIDER=openai
OPENCLAW_MINI_MODEL=glm-4-flash
OPENCLAW_MINI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENCLAW_MINI_REASONING=none

# 将智谱 API Key 填在本地 .env 中；使用 openai provider 时变量名为 OPENAI_API_KEY
OPENAI_API_KEY=

# 切换其他 Provider 时同步修改 Provider、Model、Base URL 和对应 API Key
# ANTHROPIC_API_KEY=sk-ant-xxx
# GEMINI_API_KEY=xxx
# GROQ_API_KEY=xxx

# Agent ID
# OPENCLAW_MINI_AGENT_ID=main
